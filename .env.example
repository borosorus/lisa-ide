# LISA IDE wallet configuration (all optional).
#
# Deployment addresses, not VM semantics: the IDE starts and connects a wallet
# without them, and simply keeps every LISA action disabled (AGENTS.md §3).
# Copy to `.env.local` for a local build. Do not commit real deployment values.

# Address of the deployed LISA runtime the LisaAccount delegatecalls into.
VITE_LISA_RUNTIME_ADDRESS=

# Address of the LisaAccount implementation an EIP-7702 delegation must point at.
VITE_LISA_ACCOUNT_IMPLEMENTATION_ADDRESS=
