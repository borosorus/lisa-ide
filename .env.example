# LISA IDE wallet configuration (all optional, or none of it).
#
# One deployment on one chain: the IDE starts and connects a wallet without these
# and simply keeps every LISA action disabled (AGENTS.md §1). Half a deployment is
# not a deployment — the panel reports which variable is missing.
# Copy to `.env.local` for a local build. Do not commit real deployment values.

# Decimal or hex chain id the deployment lives on. A wallet on another network is
# reported as the wrong network and never inspected or executed as if it were ready.
VITE_LISA_CHAIN_ID=

# Address of the deployed LISA runtime the LisaAccount delegatecalls into. The
# address alone is not trusted: the panel also checks that it has code.
VITE_LISA_RUNTIME_ADDRESS=

# Address of the LisaAccount implementation an EIP-7702 delegation must point at.
VITE_LISA_ACCOUNT_IMPLEMENTATION_ADDRESS=
